<?xml version="1.0"?>
<package format="3">
  <name>nav3_visualization</name>
  <version>0.1.0</version>
  <description>Lightweight Nav3 map and navigation path visualization</description>
  <maintainer email="zhoujinghao188@gmail.com">Jinghao</maintainer>
  <license>MIT</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>rclpy</exec_depend>
